{
  "manifest_version": 3,
  "name": "User-Agent Switcher",
  "version": "1.0.0",
  "description": "Switch your browser's User-Agent for testing websites.",
  "permissions": [
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "User-Agent Switcher",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "settings.html",
    "open_in_tab": true
  }
}
